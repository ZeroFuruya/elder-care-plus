# Expo + React Native works best in a pnpm monorepo with a hoisted node_modules.
# See docs/01-dev-environment.md section 6 (repo layout and conventions).
node-linker=hoisted

# Don't fail the whole install if a peer dep is missing (RN ecosystem is noisy).
strict-peer-dependencies=false

# Keep the shared store on the same drive as the repo.
shamefully-hoist=false
