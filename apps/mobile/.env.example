# apps/mobile — local environment
#
# Copy to `.env` (git-ignored). Only `EXPO_PUBLIC_` values are bundled into the
# app, so only put public values here. NEVER put the Supabase service-role key,
# or any secret, in a mobile env file (docs/01-dev-environment.md section 8.1).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
